{
  "name": "arcmd-clipper",
  "version": "0.1.0",
  "private": true,
  "description": "Web clipper browser extension for ArcMD — save web pages, highlights, and localized images to your local ArcMD spaces and databases as clean Markdown.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "zip": "node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.320",
    "@types/turndown": "^5.0.5",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
